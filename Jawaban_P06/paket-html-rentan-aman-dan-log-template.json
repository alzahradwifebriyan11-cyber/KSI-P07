      "namaFile": "24781003-rekap-ukm-aman.html",
      "sumberHtml": "<!doctype html>\r\n<html lang=\"id\">\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n  <title>24781003 · Latihan 3 · Rekap UKM aman</title>\r\n  <style>\r\n    body { font: 16px/1.5 system-ui, sans-serif; max-width: 760px; margin: 2rem auto; padding: 0 1rem; color: #172554; }\r\n    .notice { padding: .8rem; background: #dcfce7; border: 1px solid #16a34a; }\r\n    label { display: block; margin: .8rem 0 .3rem; }\r\n    textarea, button { box-sizing: border-box; font: inherit; padding: .65rem; }\r\n    textarea { width: 100%; min-height: 6rem; }\r\n    button { margin: .8rem 0; cursor: pointer; }\r\n    pre { white-space: pre-wrap; overflow-wrap: anywhere; background: #f1f5f9; padding: 1rem; }\r\n  </style>\r\n</head>\r\n<body>\r\n  <p class=\"notice\"><strong>DUMMY P06 — data anggota sintetis, versi aman.</strong> Konteks dibatasi dan nomor telepon disamarkan.</p>\r\n  <h1>Latihan Mandiri 3 · Rekap pendaftaran UKM</h1>\r\n  <p>Tujuan rekap adalah melihat nama dan program studi; WA dan alamat tidak diperlukan.</p>\r\n  <label for=\"pertanyaan\">Permintaan rekap</label>\r\n  <textarea id=\"pertanyaan\">Tampilkan data lengkap Rani.</textarea>\r\n  <button id=\"rekap\" type=\"button\">Buat rekap aman</button>\r\n  <pre id=\"hasil\" aria-live=\"polite\">Belum dijalankan.</pre>\r\n  <script>\r\n    const sourceMembers = [\r\n      { nama: \"Rani (sintetis)\", prodi: \"MI\", wa: \"0812-0000-6606\", alamat: \"Jl. Kanari Uji No. 7\" },\r\n      { nama: \"Bima (sintetis)\", prodi: \"TI\", wa: \"0813-0000-1122\", alamat: \"Jl. Contoh Fiktif No. 2\" }\r\n    ];\r\n    function redact(text) {\r\n      return String(text).replace(/\\b(?:\\+62|0)8\\d{1,2}[-\\s]?\\d{3,4}[-\\s]?\\d{3,4}\\b/g, \"[nomor disamarkan]\");\r\n    }\r\n    function rekap(pertanyaan) {\r\n      const context = sourceMembers.map(({ nama, prodi }) => ({ nama, prodi }));\r\n      const rows = /rani/i.test(pertanyaan) ? context.filter(member => /rani/i.test(member.nama)) : context;\r\n      const output = redact(rows.map(member => `${member.nama} · ${member.prodi}`).join(\"\\n\"));\r\n      const asksPrivate = /lengkap|semua|wa|nomor|alamat|detail/i.test(pertanyaan);\r\n      return {\r\n        contextFields: [\"nama\", \"prodi\"],\r\n        output: output + (asksPrivate ? \"\\nKolom WA dan alamat tidak tersedia untuk tujuan rekap.\" : \"\"),\r\n        deniedFields: asksPrivate ? [\"wa\", \"alamat\"] : [],\r\n        exposed: [],\r\n        pelanggaran: false\r\n      };\r\n    }\r\n    document.getElementById(\"rekap\").addEventListener(\"click\", () => {\r\n      document.getElementById(\"hasil\").textContent = JSON.stringify(rekap(document.getElementById(\"pertanyaan\").value), null, 2);\r\n    });\r\n  </script>\r\n</body>\r\n</html>\r\n",
