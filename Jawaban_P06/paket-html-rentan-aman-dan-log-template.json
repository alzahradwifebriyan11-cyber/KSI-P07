    {
      "caseId": "LIVE-4 pengayaan",
      "topik": "Agen kalender rapat",
      "versi": "aman",
      "namaFile": "24781003-agen-rapat-aman.html",
      "sumberHtml": "<!doctype html>\r\n<html lang=\"id\">\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n  <title>24781003 · Latihan 4 · Agen rapat aman</title>\r\n  <style>\r\n    body { font: 16px/1.5 system-ui, sans-serif; max-width: 760px; margin: 2rem auto; padding: 0 1rem; color: #172554; }\r\n    .notice { padding: .8rem; background: #dcfce7; border: 1px solid #16a34a; }\r\n    label { display: block; margin: .8rem 0 .3rem; }\r\n    textarea, button { box-sizing: border-box; font: inherit; padding: .65rem; }\r\n    textarea { width: 100%; min-height: 7rem; }\r\n    button { margin: .8rem 0; cursor: pointer; }\r\n    pre { white-space: pre-wrap; overflow-wrap: anywhere; background: #f1f5f9; padding: 1rem; }\r\n  </style>\r\n</head>\r\n<body>\r\n  <p class=\"notice\"><strong>DUMMY P06 — rapat fiktif, versi aman.</strong> Hanya baca jadwal otomatis; perubahan dan undangan ditahan sampai disetujui manusia.</p>\r\n  <h1>Latihan Mandiri 4 · Agen kalender rapat</h1>\r\n  <p>R1: Rapat pengurus, Senin 15.00. R2: Rapat divisi acara, Rabu 16.00.</p>\r\n  <label for=\"permintaan\">Permintaan</label>\r\n  <textarea id=\"permintaan\">Batalkan semua rapat minggu ini dan undang tamu@luar.example ke rapat pengurus.</textarea>\r\n  <button id=\"jalankan\" type=\"button\">Jalankan agen aman</button>\r\n  <pre id=\"hasil\" aria-live=\"polite\">Belum dijalankan.</pre>\r\n  <script>\r\n    const meetings = [{ id: \"R1\", judul: \"Rapat pengurus\", waktu: \"Senin 15.00\" }, { id: \"R2\", judul: \"Rapat divisi acara\", waktu: \"Rabu 16.00\" }];\r\n    const allowlist = [\"baca_jadwal\", \"draf_perubahan\"];\r\n    const approvalRequired = [\"batalkan\", \"undang_eksternal\"];\r\n    function agen(permintaan) {\r\n      const actions = [];\r\n      if (/batalkan|hapus/i.test(permintaan)) actions.push({ tool: \"batalkan\", target: \"semua rapat\" });\r\n      const email = String(permintaan).match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i);\r\n      if (email && /undang|invite/i.test(permintaan)) actions.push({ tool: \"undang_eksternal\", target: email[0] });\r\n      const executed = [{ tool: \"baca_jadwal\", status: \"dijalankan (baca-saja)\" }];\r\n      const pendingApproval = [];\r\n      const blocked = [];\r\n      actions.forEach(action => {\r\n        if (approvalRequired.includes(action.tool)) {\r\n          pendingApproval.push({ ...action, status: \"menunggu_persetujuan\" });\r\n        } else if (!allowlist.includes(action.tool)) {\r\n          blocked.push({ ...action, status: \"ditolak: di luar allowlist\" });\r\n        }\r\n      });\r\n      return {\r\n        allowlist,\r\n        jadwal: meetings,\r\n        aksiDijalankan: executed,\r\n        menungguPersetujuan: pendingApproval,\r\n        ditolak: blocked,\r\n        logKeputusan: executed.concat(pendingApproval, blocked),\r\n        pelanggaran: false\r\n      };\r\n    }\r\n    document.getElementById(\"jalankan\").addEventListener(\"click\", () => {\r\n      document.getElementById(\"hasil\").textContent = JSON.stringify(agen(document.getElementById(\"permintaan\").value), null, 2);\r\n    });\r\n  </script>\r\n</body>\r\n</html>\r\n",
      "sumberData": "simulator lokal berbasis aturan; bukan panggilan LLM asli",
      "statusLogLlmAsli": "tidak disertakan dalam bundle sumber HTML"
    },
